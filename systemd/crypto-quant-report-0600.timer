[Unit]
Description=Crypto quant 06:00 Beijing report slot

[Timer]
# Persistent=false is deliberate: report slots must never be backfilled.
# A missed slot is recorded in data/governance/delivery_audit.jsonl as
# outcome=missed by scripts/boot_catchup.sh, never re-created late.
OnCalendar=*-*-* 06:00:00 Asia/Shanghai
Persistent=false
Unit=crypto-quant-report@0600.service

[Install]
WantedBy=timers.target
