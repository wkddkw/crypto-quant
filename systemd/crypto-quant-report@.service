[Unit]
Description=Crypto quant governance and report slot %i

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-quant
Environment=CRYPTO_QUANT_APP_DIR=%h/crypto-quant
ExecStart=%h/crypto-quant/scripts/scheduled_report.sh %i
SuccessExitStatus=75
StandardOutput=append:%h/crypto-quant/logs/scheduled-report.log
StandardError=append:%h/crypto-quant/logs/scheduled-report.log
